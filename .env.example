# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# Username for the site-wide Basic Auth login prompt (optional, default: credly)
SITE_USER=credly

# Password for the site-wide access gate (protects the whole site). Required.
SITE_PASSWORD=change-this-site-password

# Password protecting profile add/remove actions. Required.
APP_PASSWORD=change-this-admin-password

# Port the server listens on (optional, default: 3002)
# PORT=3002
